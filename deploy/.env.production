# =============================================================
# GESTOR DE DEMANDAS — Variáveis de Ambiente (PRODUÇÃO)
# Renomeie este arquivo para .env no servidor e preencha os valores
# NUNCA commite este arquivo com valores reais!
# =============================================================

# -------------------------------------------------------
# Supabase / PostgreSQL
# -------------------------------------------------------
# Connection pooling (Supabase Pooler — porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (usado por prisma migrate deploy)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# -------------------------------------------------------
# Supabase Auth
# -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# -------------------------------------------------------
# App
# -------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# URL pública da aplicação (sem barra final)
NEXT_PUBLIC_APP_URL="https://seu-dominio.com.br"

# Origins permitidos para Server Actions (separados por vírgula)
ALLOWED_ORIGINS="seu-dominio.com.br,www.seu-dominio.com.br"
