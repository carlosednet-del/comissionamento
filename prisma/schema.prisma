generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum UserRole {
  ADMIN
  DIRETOR
  GESTOR
  DEV
  SUPORTE
  ARQUITETO
  APROVADOR
  FINANCEIRO
  SOLICITANTE
  DAP
}

enum WorkerProfile {
  JUNIOR
  PLENO
  SENIOR
  ESPECIALISTA
}

enum ComplexityLevel {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum RoiLevel {
  BAIXO
  MEDIO
  ALTO
  ESTRATEGICO
}

enum DemandType {
  NOVA_SOLUCAO
  EVOLUCAO_PRODUCAO
  CORRECAO
  AUTOMACAO
  DASHBOARD
  INTEGRACAO
  OUTRO
}

enum DemandPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum DemandStatus {
  RASCUNHO
  ABERTA
  EM_ANALISE
  PRIORIZACAO_DIRETORIA
  APROVADA
  EM_DESENVOLVIMENTO
  AGUARDANDO_HOMOLOGACAO
  HOMOLOGADA_PRODUCAO
  REPROVADA
  CANCELADA
  CONCLUIDA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVAL
  REJECTION
  HOMOLOGATION
  DEVELOPMENT_STARTED
  SENT_TO_HOMOLOGATION
  DEMAND_CANCELED
  EVIDENCE_ADDED
  SENT_TO_DIRECTOR_PRIORITIZATION
  DIRECTOR_PRIORITY_SET
  DEMAND_PRIORITIZED_AND_APPROVED
  DEMAND_RETURNED_FROM_DIRECTOR_PRIORITIZATION
  STATEMENT_SIGNED
  STATEMENT_EXPORTED
  DAP_CLOSING_PREVIEWED
  DAP_PERIOD_EXPORTED
  DAP_DEVELOPER_STATEMENT_EXPORTED
  EXECUTIVE_DASHBOARD_EXPORTED
  PASSWORD_CHANGED
  PASSWORD_RESET_FORCED
}

enum StatementStatus {
  PENDING
  SIGNED
  EXPORTED
  CANCELED
}

// -------------------------------------------------------
// Models
// -------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  authUserId    String?        @unique
  name          String
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role              UserRole       @default(DEV)
  workerProfile     WorkerProfile?
  isActive          Boolean        @default(true)
  /// Salário base mensal (R$). Só o excedente acima do salário é "a pagar".
  monthlyBaseSalary Float?
  /// Teto mensal individual (R$). Sobrepõe o teto de perfil quando preenchido.
  monthlyCapValue      Float?
  /// Força troca de senha no próximo login (primeiro acesso ou reset admin).
  forcePasswordChange  Boolean  @default(false)
  /// Especialidade técnica principal (ex.: Power BI, Backend, Dados). Opcional.
  technicalSpecialty   String?
  /// Quando true, o usuário autentica via Microsoft Entra ID (login com e-mail/senha desabilitado).
  useEntraId           Boolean  @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  accounts           Account[]
  createdDemands     Demand[]         @relation("DemandCreator")
  assignedDemands    Demand[]         @relation("DemandAssignee")
  approvedDemands    Demand[]         @relation("DemandApprover")
  homologatedDemands Demand[]         @relation("DemandHomologator")
  canceledDemands    Demand[]         @relation("DemandCanceler")
  prioritizedDemands Demand[]         @relation("DemandPrioritizer")
  auditLogs          AuditLog[]
  createdEvidences   DemandEvidence[] @relation("EvidenceCreator")
  directedDemands    Demand[]         @relation("DemandDirector")
  statements         DeveloperMonthlyStatement[] @relation("StatementDeveloper")
  signedStatements   DeveloperMonthlyStatement[] @relation("StatementSigner")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Demand {
  id                   String         @id @default(cuid())
  title                String
  description          String
  requesterArea        String
  requesterName        String
  requesterEmail       String?
  demandType           DemandType
  priority             DemandPriority @default(MEDIA)
  status               DemandStatus   @default(RASCUNHO)
  systemAffected       String?
  businessProblem      String?
  expectedResult       String?
  impactDescription    String?
  dependencies         String?
  risks                String?
  observations         String?
  acceptanceCriteria   String?
  expectedEvidence     String?
  estimatedHours          Float?
  complexity              ComplexityLevel?
  roi                     RoiLevel?
  estimatedDemandValue    Float?
  assigneeProfileSnapshot WorkerProfile?
  hourlyRateSnapshot      Float?
  plannedStartDate        DateTime?
  plannedDeliveryDate  DateTime?
  actualStartDate      DateTime?
  actualDeliveryDate   DateTime?
  homologationDate     DateTime?
  assigneeId           String?
  creatorId            String
  approvedById         String?
  homologatedById      String?
  canceledById         String?
  prioritizedById      String?
  directorPriorityOrder Int?
  directorId           String?
  prioritizedAt        DateTime?
  prioritizationNotes  String?
  approvedAt           DateTime?
  canceledAt           DateTime?
  cancellationReason   String?
  rejectionReason      String?
  deliveryNotes        String?
  homologationNotes    String?
  isPedra              Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  assignee      User?            @relation("DemandAssignee",    fields: [assigneeId],    references: [id])
  creator       User             @relation("DemandCreator",     fields: [creatorId],     references: [id])
  approvedBy    User?            @relation("DemandApprover",    fields: [approvedById],  references: [id])
  homologatedBy User?            @relation("DemandHomologator", fields: [homologatedById], references: [id])
  canceledBy    User?            @relation("DemandCanceler",    fields: [canceledById],  references: [id])
  prioritizedBy User?            @relation("DemandPrioritizer", fields: [prioritizedById], references: [id])
  director      User?            @relation("DemandDirector",    fields: [directorId],    references: [id])
  evidences      DemandEvidence[]
  statementItems DeveloperMonthlyStatementItem[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([directorId])
  @@index([homologationDate])
  @@map("demands")
}

model DemandEvidence {
  id          String   @id @default(cuid())
  demandId    String
  title       String
  url         String
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  demand    Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EvidenceCreator", fields: [createdById], references: [id])

  @@map("demand_evidences")
}

/// Armazena a imagem de evidência no próprio banco, servida por /api/evidence/[id].
/// Substitui o Supabase Storage; a DemandEvidence.url aponta para essa rota.
model EvidenceImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@map("evidence_images")
}

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  userId    String
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

/// Configuração de precificação por perfil — editável pelo ADMIN via UI.
/// Valores ausentes no banco caem de volta para os defaults em lib/demand-pricing.ts.
model HourlyRateConfig {
  profile     WorkerProfile @id
  ratePerHour Float
  monthlyCap  Float
  updatedAt   DateTime      @updatedAt

  @@map("hourly_rate_configs")
}

/// Fator combinado (complexidade × ROI) customizável pelo ADMIN.
model CombinedFactorConfig {
  complexity ComplexityLevel
  roi        RoiLevel
  factor     Float
  updatedAt  DateTime        @updatedAt

  @@id([complexity, roi])
  @@map("combined_factor_configs")
}

/// Fator do deflator por dias de atraso (0–5) customizável pelo ADMIN.
/// daysLate=5 representa "5 ou mais DU".
model DeflatorConfig {
  daysLate  Int      @id
  factor    Float
  updatedAt DateTime @updatedAt

  @@map("deflator_configs")
}

/// Taxa de mercado por perfil técnico — benchmark externo editável pelo ADMIN.
model BenchmarkRateConfig {
  profile    WorkerProfile @id
  marketRate Float
  updatedAt  DateTime      @updatedAt

  @@map("benchmark_rate_configs")
}

/// Acelerador de equipe (% de ganho de produtividade) — benchmark editável pelo ADMIN.
/// Armazenado como linha única (id = 1). Padrão: 20 (%).
model BenchmarkAcceleratorConfig {
  id          Int      @id @default(1)
  accelerator Float    @default(20)
  updatedAt   DateTime @updatedAt

  @@map("benchmark_accelerator_configs")
}


// ── Extrato mensal do desenvolvedor ───────────────────────────────

/// Extrato mensal consolidado de demandas homologadas por um DEV.
model DeveloperMonthlyStatement {
  id          String @id @default(uuid())
  developerId String
  periodMonth Int
  periodYear  Int

  status              StatementStatus @default(PENDING)
  totalDemands        Int             @default(0)
  totalEstimatedHours Float           @default(0)
  totalEstimatedValue Float           @default(0)

  signedAt           DateTime?
  signedById         String?
  signatureIp        String?
  signatureUserAgent String?
  signatureCode      String?  @unique
  contentHash        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  developer User                            @relation("StatementDeveloper", fields: [developerId], references: [id])
  signedBy  User?                           @relation("StatementSigner",    fields: [signedById],   references: [id])
  items     DeveloperMonthlyStatementItem[]

  @@unique([developerId, periodMonth, periodYear])
  @@map("developer_monthly_statements")
}

/// Item materializado de um extrato assinado — snapshot imutável do momento da assinatura.
model DeveloperMonthlyStatementItem {
  id          String @id @default(uuid())
  statementId String
  demandId    String

  demandCode    String?
  demandTitle   String
  requesterArea String?
  demandType    String?
  complexity    String?
  roi           String?

  estimatedHours   Float
  hourlyRate       Float?
  estimatedValue   Float
  homologationDate DateTime?

  createdAt DateTime @default(now())

  statement DeveloperMonthlyStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  demand    Demand                    @relation(fields: [demandId],    references: [id])

  @@unique([statementId, demandId])
  @@map("developer_monthly_statement_items")
}
