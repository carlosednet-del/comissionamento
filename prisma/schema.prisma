generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------
// Enums
// -------------------------------------------------------

enum UserRole {
  ADMIN
  GESTOR
  DEV
  APROVADOR
  FINANCEIRO
}

enum WorkerProfile {
  JUNIOR
  PLENO
  SENIOR
  ESPECIALISTA
}

enum ComplexityLevel {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum RoiLevel {
  BAIXO
  MEDIO
  ALTO
  ESTRATEGICO
}

enum DemandType {
  NOVA_SOLUCAO
  EVOLUCAO_PRODUCAO
  CORRECAO
  AUTOMACAO
  DASHBOARD
  INTEGRACAO
  OUTRO
}

enum DemandPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum DemandStatus {
  RASCUNHO
  ABERTA
  EM_ANALISE
  APROVADA
  EM_DESENVOLVIMENTO
  AGUARDANDO_HOMOLOGACAO
  HOMOLOGADA_PRODUCAO
  REPROVADA
  CANCELADA
  CONCLUIDA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVAL
  REJECTION
  HOMOLOGATION
  DEVELOPMENT_STARTED
  SENT_TO_HOMOLOGATION
  DEMAND_CANCELED
  EVIDENCE_ADDED
}

// -------------------------------------------------------
// Models
// -------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  authUserId    String?        @unique
  name          String
  email         String         @unique
  role          UserRole       @default(DEV)
  workerProfile WorkerProfile?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdDemands     Demand[]         @relation("DemandCreator")
  assignedDemands    Demand[]         @relation("DemandAssignee")
  approvedDemands    Demand[]         @relation("DemandApprover")
  homologatedDemands Demand[]         @relation("DemandHomologator")
  canceledDemands    Demand[]         @relation("DemandCanceler")
  auditLogs          AuditLog[]
  createdEvidences   DemandEvidence[] @relation("EvidenceCreator")

  @@map("users")
}

model Demand {
  id                   String         @id @default(cuid())
  title                String
  description          String
  requesterArea        String
  requesterName        String
  requesterEmail       String?
  demandType           DemandType
  priority             DemandPriority @default(MEDIA)
  status               DemandStatus   @default(RASCUNHO)
  systemAffected       String?
  businessProblem      String?
  expectedResult       String?
  impactDescription    String?
  dependencies         String?
  risks                String?
  observations         String?
  estimatedHours          Float?
  complexity              ComplexityLevel?
  roi                     RoiLevel?
  estimatedDemandValue    Float?
  assigneeProfileSnapshot WorkerProfile?
  hourlyRateSnapshot      Float?
  plannedStartDate        DateTime?
  plannedDeliveryDate  DateTime?
  actualStartDate      DateTime?
  actualDeliveryDate   DateTime?
  homologationDate     DateTime?
  assigneeId           String?
  creatorId            String
  approvedById         String?
  homologatedById      String?
  canceledById         String?
  approvedAt           DateTime?
  canceledAt           DateTime?
  cancellationReason   String?
  rejectionReason      String?
  deliveryNotes        String?
  homologationNotes    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  assignee      User?            @relation("DemandAssignee",    fields: [assigneeId],    references: [id])
  creator       User             @relation("DemandCreator",     fields: [creatorId],     references: [id])
  approvedBy    User?            @relation("DemandApprover",    fields: [approvedById],  references: [id])
  homologatedBy User?            @relation("DemandHomologator", fields: [homologatedById], references: [id])
  canceledBy    User?            @relation("DemandCanceler",    fields: [canceledById],  references: [id])
  evidences     DemandEvidence[]

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@map("demands")
}

model DemandEvidence {
  id          String   @id @default(cuid())
  demandId    String
  title       String
  url         String
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  demand    Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("EvidenceCreator", fields: [createdById], references: [id])

  @@map("demand_evidences")
}

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  oldValue  Json?
  newValue  Json?
  userId    String
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
